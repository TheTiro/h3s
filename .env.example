# Copy to .env.local and fill in values. Never commit real secrets.

NEXT_PUBLIC_SITE_URL=https://h3studios.ba

# Contact form recipient — who receives submissions (server-side only)
CONTACT_RECIPIENT_EMAIL=info@h3studios.ba

# Google reCAPTCHA v3 — https://www.google.com/recaptcha/admin (type: v3)
# Domains: h3studios.ba + localhost
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# RECAPTCHA_MIN_SCORE=0.5

# SMTP (Nodemailer) — mailbox that sends the contact form
MAIL_HOST=mail.h3studios.ba
MAIL_PORT=587
MAIL_USERNAME=no-reply@h3studios.ba
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@h3studios.ba

# Optional alternate names used by some hosts
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

# Contact message validation (defaults in lib/site.ts: min 20 / max 256)
# CONTACT_MESSAGE_MIN_LENGTH=20
# CONTACT_MESSAGE_MAX_LENGTH=256
